{
  "name": "ai-benchmark-game",
  "version": "0.1.0",
  "private": true,
  "description": "A .io-style web game benchmark for LLM agents: Grid Snake.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "match": "tsx src/index.ts",
    "serve": "tsx src/server/index.ts",
    "agent": "tsx src/agents/sample-agent.ts",
    "agent:llm": "tsx src/agents/llm-agent.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server/index.js",
    "import-files": "tsx scripts/import-files.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "pg": "^8.21.0",
    "ws": "^8.21.0"
  }
}
